[
  {
    "id": "54468313088",
    "key": "Quest.At_Home_In_Zakrajev.Subtitle",
    "en": "A roof over one’s head"
  },
  {
    "id": "54493478912",
    "key": "Quest.At_Home_In_Zakrajev.Description",
    "en": "Long journey to Dazbog – exhausted.\n\nIlya told me someone nearby can point to big job\n\nHave to keep working..."
  },
  {
    "id": "54497673216",
    "key": "Quest.At_Home_In_Zakrajev.CompleteDescription",
    "en": "Did a favor for Zhivan, a Vulture – found and cleared a spot in Zakrajev Line for him to set up a shack.\n\nHe helped find next job: a Mechanist at Sontse Station can pay big for dangerous scavenge\n\nOnly way to break endless cycle – tired, no gear, no hope. Must risk it"
  },
  {
    "id": "54497673217",
    "key": "Quest.Rat Killer.Subtitle",
    "en": "Big Rat Killer"
  },
  {
    "id": "54497673218",
    "key": "Quest.Rat Killer.Description",
    "en": "I need you to kill some rats for me, they've been plaguing the settlement for some time. Even killed a scav last week! Of course, I will have a reward for you if it all goes well."
  },
  {
    "id": "54497673219",
    "key": "Quest.Rat Killer.CompleteDescription",
    "en": "Thanks, good ridance. Here is your reward."
  },
  {
    "id": "54497673220",
    "key": "Quest.Catching Current.Subtitle",
    "en": "Investigating the anomalies"
  },
  {
    "id": "54497673221",
    "key": "Quest.Catching Current.Description",
    "en": "Anatoly mentioned more work to be done\n\nInvestigating an Aspect...?"
  },
  {
    "id": "54497673222",
    "key": "Quest.Corpse_Bearers.Subtitle",
    "en": "The Mist will bloom"
  },
  {
    "id": "54497673223",
    "key": "Quest.Corpse_Bearers.Description",
    "en": "Alexei worried about corpses around the Mire – drawing Mist fast\nHave to alert Mudlarks – they drag corpses to Lake, drown out Mist\n\nFind them in Dazbog Hollow, to North-Northwest"
  },
  {
    "id": "54497673224",
    "key": "Quest.Corpse_Bearers.CompleteDescription",
    "en": "Alexei worried about corpses around the Mire – drawing Mist fast\nWas hired to call in Mudlarks from Dazbog Hollow — they take bodies to Lake Pavlie\n\nTold Mudlark named Ilya about corpses…\nTo be consumed by Mist — maybe a comfortable feeling\n\nIlya said someone nearby could use my help"
  },
  {
    "id": "54497673225",
    "key": "Quest.Dead_Man_Rest.Subtitle",
    "en": "Back in limbo"
  },
  {
    "id": "54497673226",
    "key": "Quest.Dead_Man_Rest.Description",
    "en": "Woke up in hospital – sharp pain in back\n\nDark visions of Scrapyard before fainting – weapons, armor, all gone…\n\nNote near the bed – who?"
  },
  {
    "id": "54497673227",
    "key": "Quest.Dead_Man_Rest.CompleteDescription",
    "en": "Met Alexei at Cemetery. He treated me after I was shot\n\nNow doing a funeral – young Palatine who died rescuing me\n\nNeeded something from me, so we talked"
  },
  {
    "id": "54497673228",
    "key": "Quest.Desperate_Groundwork_QuestSO.Subtitle",
    "en": "Field work is tough"
  },
  {
    "id": "54497673229",
    "key": "Quest.Desperate_Groundwork_QuestSO.Description",
    "en": "Mila, from Rada – got scared investigating nearby camps\n\nHired me to find camp south of train track passage and other near west border checkpoint"
  },
  {
    "id": "54497673230",
    "key": "Quest.Desperate_Groundwork_QuestSO.CompleteDescription",
    "en": "Mila learned the history of the nearby camps\n\nThey’re all dead now - letters tell story. She's disheartened\n\nAlways how it is - no space for hope. Maybe in afterlife"
  },
  {
    "id": "54497673231",
    "key": "Quest.Rituals_And_Keepsakes_QuestSO.Subtitle",
    "en": "Remembering sacrifice"
  },
  {
    "id": "54497673232",
    "key": "Quest.Rituals_And_Keepsakes_QuestSO.Description",
    "en": "Found a dog tag on corpse of young dead Palatine\n\nShould return it to their headquarters – up northwest from Cemetery. Might be a reward"
  },
  {
    "id": "54497673233",
    "key": "Quest.Rituals_And_Keepsakes_QuestSO.CompleteDescription",
    "en": "Found a dog tag on corpse of young dead Palatine\n\nGot reward for returning it to the Palatine, Yelena\nLooked heart broken – why? Why care about another soldier?"
  },
  {
    "id": "54497673234",
    "key": "Quest.Scrapyard_Introduction_QuestSO.Subtitle",
    "en": "Mud, blood and grime"
  },
  {
    "id": "54497673235",
    "key": "Quest.Scrapyard_Introduction_QuestSO.Description",
    "en": "Another trek through the Dola – found a scrapyard, looked promising\nMore Bandits than usual – followed?\n\nMust be careful"
  },
  {
    "id": "54497673236",
    "key": "Quest.Scrapyard_Introduction_QuestSO.CompleteDescription",
    "en": "Scav went wrong\nFelt a hit – unconscious\nHow am I still alive?"
  },
  {
    "id": "54497673237",
    "key": "Quest.TestQuest.Subtitle",
    "en": "Greedy Bandits"
  },
  {
    "id": "54497673238",
    "key": "Quest.TestQuest.Description",
    "en": "Some corpses of recently deceased bandits where thrown in the Lake, but some are still around the area. I need to retrieve a valuable piece of armor plating before the Mudlarks finish their job."
  },
  {
    "id": "54497673239",
    "key": "Quest.TestQuest.CompleteDescription",
    "en": "I got the armor plating back to Grigory and got my reward."
  },
  {
    "id": "54497673240",
    "key": "Quest.Trespassing Svarog.Subtitle",
    "en": "How Vultures die"
  },
  {
    "id": "54497673241",
    "key": "Quest.Trespassing Svarog.Description",
    "en": "Anatoly – arrogant Mechanist willing to pay big for a special toolbox\nOnly found in Svarog Factories – swarming with Bandits and Gunners killing each other\n\nHe suggested seeing Grigory, the arms dealer, to prepare"
  },
  {
    "id": "54497673242",
    "key": "Quest.Trespassing Svarog.CompleteDescription",
    "en": "Anatoly hired me to find a special toolbox at the Factories\r\n\r\nThat place is chaos\r\n\r\nBut I made it – now he says he has more in store for me"
  },
